  },
  {
    "label": "Reboot to Arch",
    "exec": "reboot_to_arch",
    "icon": "/usr/share/nwg-bar/images/system-reboot.svg"
  },
  {
    "label": "Reboot to Windows",
    "exec": "reboot_to_windows",
    "icon": "/usr/share/nwg-bar/images/system-reboot.svg"
  },
  {
